{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daedyx Tasks",
  "version": "0.1.0",
  "mainBinaryName": "daedyx-tasks",
  "identifier": "de.daedyx.tasks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daedyx Tasks",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://raw.githubusercontent.com/daedyx/releases/main/tasks/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
